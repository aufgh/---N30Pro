--- a/etc/multilogin/login_control.bash
+++ b/etc/multilogin/login_control.bash
@@ -205,14 +205,6 @@
     fi
     
     local current_time=$(date +%s)
-    local mwan3_status_output=$(mwan3 interfaces 2>/dev/null)
-    
-    if [ -z "$mwan3_status_output" ]; then
-        log "warning" "Failed to get mwan3 status. Retrying in $MAIN_LOOP_SLEEP seconds."
-        sleep $MAIN_LOOP_SLEEP
-        continue
-    fi
-    
     for i in "${!logical_interfaces[@]}"; do
       local interface="${logical_interfaces[$i]}"
       local time_diff=$((current_time - last_login_time[$i]))
@@ -221,18 +213,12 @@
         continue
       fi
       
-      # Use mwan3 only to confirm that the interface exists and tracking is active.
-      # A captive portal can still answer ping before authentication, so mwan3's
-      # online state is not sufficient to decide whether login is required.
-      local interface_line=$(echo "$mwan3_status_output" | grep "interface $interface ")
-      
-      if [ -z "$interface_line" ]; then
-        log "debug" "Interface '$interface' not found in mwan3 status, skipping."
-        continue
-      fi
-
-      if echo "$interface_line" | grep -q "tracking is down"; then
-        log "debug" "Interface '$interface' tracking is down, skipping login attempt."
+      # Authentication must continue when load balancing is disabled.
+      # netifd's link/address state is independent of mwan3 tracking.
+      local interface_up=$(ifstatus "$interface" 2>/dev/null | jsonfilter -e '@.up')
+      local interface_ip=$(ifstatus "$interface" 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address')
+      if [ "$interface_up" != "true" ] || [ -z "$interface_ip" ]; then
+        log "debug" "Interface '$interface' has no active IPv4 uplink, skipping."
         continue
       fi
 
--- a/etc/multilogin/quick_setup.sh
