+	DEPENDS:=$(GO_ARCH_DEPENDS) +luci-compat +libubox-lua +nftables-json +ip-full +kmod-nft-tproxy +kmod-nft-fib +kmod-nft-queue +kmod-nf-conntrack-netlink
