--- a/openwrt/files/ua3f.init
+++ b/openwrt/files/ua3f.init
@@ -98,6 +98,25 @@
     procd_set_param pidfile "/var/run/$NAME.pid"
 
     procd_close_instance
+
+    local transparent_proxy
+    config_get_bool transparent_proxy "main" "transparent_proxy" 0
+    if [ "$transparent_proxy" -eq "1" ]; then
+        if /usr/libexec/n30pro-ua3f-tproxy start; then
+            procd_open_instance "ua3f-tproxy"
+            procd_set_param command /usr/bin/hev-socks5-tproxy /var/run/ua3f-tproxy/hev.yml
+            procd_set_param file /var/run/ua3f-tproxy/hev.yml
+            procd_set_param respawn
+            procd_set_param stdout 1
+            procd_set_param stderr 1
+            procd_set_param limits nofile="65535 65535"
+            procd_close_instance
+        fi
+    fi
+}
+
+stop_service() {
+    /usr/libexec/n30pro-ua3f-tproxy stop
 }
 
 reload_service() {
@@ -106,5 +125,5 @@
 }
 
 service_triggers() {
-    procd_add_reload_trigger "$NAME"
+    procd_add_reload_trigger "$NAME" "network"
 }
